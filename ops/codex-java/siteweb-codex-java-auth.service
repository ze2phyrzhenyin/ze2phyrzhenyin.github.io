[Unit]
Description=Codex Java tutorial access-code verification
After=network.target

[Service]
Type=simple
DynamicUser=yes
User=siteweb-codex-auth
Group=www-data
LoadCredential=auth.json:/etc/siteweb-codex-java/auth.json
ExecStart=/usr/local/bin/node --max-old-space-size=48 /usr/local/lib/siteweb-codex-java-auth/auth-server.mjs
RuntimeDirectory=siteweb-codex-java-auth
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=128M
CPUQuota=20%
TasksMax=32

[Install]
WantedBy=multi-user.target
