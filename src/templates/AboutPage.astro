          { name: 'Three.js', icon: '/icons/skills/threedotjs.svg' },
          { name: 'Linux', icon: '/icons/skills/linux.svg', highlight: true },
          { name: 'Git', icon: '/icons/skills/git.svg', highlight: true },
          { name: 'LaTeX', icon: '/icons/skills/latex.svg', highlight: true },
          { name: 'XML / XSD', mark: 'XSD' },
          { name: 'OpenXML', mark: 'XML' },
        ],
      },
    ],
    experience: [
      {
        title: 'Ingénieur de développement C++',
        meta: 'Shanghai Zhunshi Intelligent Information Technology Co., Ltd. · Shanghai',
        date: 'Mai 2023 - Déc. 2023',
        points: [
          "Développement d'algorithmes de conversion de formats .xml et .xsd avec récursivité et fonctionnalités de conversion intégrées de Visual Studio.",
          "Développement indépendant du site web de l'entreprise avec React, Node.js, Nginx et outils associés.",
        ],
      },
      {
        title: 'Ingénieur de test',
        meta: 'Lankuaikei Agricultural Technology (Shanghai) Co., Ltd. · Shanghai',
        date: 'Juil. 2022 - Sept. 2022',
        points: ['Tests de logiciels pour grands écrans et mobile, avec rédaction de documentation de test.'],
      },
    ],
    skills: [
      { key: 'about.lang', items: ['Mandarin (langue maternelle)', 'Anglais (B1+)', 'Français (B1+)'] },
      {
        key: 'about.sports',
        items: [
          'Go : 4e dan amateur chinois',
          'Tennis : niveau NTRP 2.5',
          'Badminton : niveau compétition en club amateur',
          'Football : niveau compétition en club amateur',
          'Ultimate frisbee : niveau compétition en club amateur',
          'Tennis de table : niveau match simple',
          'Course de fond',
        ],
      },
    ],
  },
};

const profile = aboutContent[lang] ?? aboutContent.en;
const intro = aboutIntro[lang] ?? aboutIntro.en;
---
<Base title={t('about.title')} description={`${t('about.title')} — ${siteName}`}>
  <div class="container-mid py-16">
    <div class="mb-10 animate-fade-up">
      <h1 class="text-4xl font-bold tracking-tight"
          style="color:rgb(var(--text));letter-spacing:-0.025em;">{t('about.title')}</h1>
    </div>

    <!-- Bio prose -->
    <div class="prose dark:prose-invert max-w-none mb-14 animate-fade-up delay-100">
      {intro.map((paragraph, index) => (
        index === 1 ? (
          <blockquote>
            {paragraph.map((part) => part.href ? (
              <a href={part.href} target="_blank" rel="noopener">{part.text}</a>
            ) : part.text)}
          </blockquote>
        ) : (
          <p>
            {paragraph.map((part) => part.href ? (
              <a href={part.href} target="_blank" rel="noopener">{part.text}</a>
            ) : part.text)}
          </p>
        )
      ))}
    </div>

    <div class="space-y-12 animate-fade-up delay-200">
      <!-- Education -->
      <section id="education">
        <div class="flex items-center gap-4 mb-6">
          <h2 class="section-title shrink-0">{t('about.education')}</h2>
          <div class="flex-1 h-px" style="background:rgb(var(--border));"></div>
        </div>
        <div class="space-y-6">
          {profile.education.map((entry) => (
            <div class="timeline-entry">
              <div class="timeline-main">
                <p class="font-semibold" style="color:rgb(var(--text));">{entry.title}</p>
                <p class="text-sm" style="color:rgb(var(--text-2));">{entry.meta}</p>
              </div>
              <span class="font-mono text-xs tabular self-start" style="color:rgb(var(--muted));">{entry.date}</span>
              {entry.points && (
                <ul class="timeline-points mt-2 text-sm space-y-0.5 list-disc list-outside pl-5" style="color:rgb(var(--text-2));">
                  {entry.points.map((point) => <li>{point}</li>)}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Research experience -->
      <section>
        <div class="flex items-center gap-4 mb-6">
          <h2 class="section-title shrink-0">{t('about.experience')}</h2>
          <div class="flex-1 h-px" style="background:rgb(var(--border));"></div>
        </div>
        <div class="space-y-6">
          {profile.experience.map((entry) => (
            <div class="timeline-entry">
              <div class="timeline-main">
                <p class="font-semibold" style="color:rgb(var(--text));">{entry.title}</p>
                <p class="text-sm mb-1.5" style="color:rgb(var(--text-2));">{entry.meta}</p>
              </div>
              <span class="font-mono text-xs tabular self-start" style="color:rgb(var(--muted));">{entry.date}</span>
              {entry.points && (
                <ul class="timeline-points text-sm space-y-1 list-disc list-outside pl-5" style="color:rgb(var(--text-2));">
                  {entry.points.map((point) => <li>{point}</li>)}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Technical skills -->
      <section>
        <div class="flex items-center gap-4 mb-6">
          <h2 class="section-title shrink-0">{t('about.interests')}</h2>
          <div class="flex-1 h-px" style="background:rgb(var(--border));"></div>
        </div>
        <div class="space-y-8">
          {profile.techSkills.map((group) => (
            <div class={`tech-skill-group${group.highlight ? ' tech-skill-group-lit' : ''}`}>
              <div class="tech-skill-heading">
                <h3 class="text-sm font-semibold" style="color:rgb(var(--text));">{group.title}</h3>
              </div>
              <div class="tech-skill-grid">
                {group.items.map((skill) => (
                  <div class={`tech-skill-card${skill.highlight ? ' tech-skill-card-lit' : ''}`}>
                    <span class="tech-skill-icon" aria-hidden="true">
                      {skill.icon ? (
                        <img src={withBase(skill.icon)} alt="" loading="lazy" decoding="async" />
                      ) : (
                        <span>{skill.mark}</span>
                      )}
                    </span>
                    <span class="min-w-0">
                      <span class="tech-skill-name">{skill.name}</span>
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Skills -->
      <section>
        <div class="flex items-center gap-4 mb-6">
          <h2 class="section-title shrink-0">{t('about.skills')}</h2>
          <div class="flex-1 h-px" style="background:rgb(var(--border));"></div>
        </div>
        <div class="grid sm:grid-cols-2 gap-6">
          {profile.skills.map(({ key, items }) => (
            <div>
              <p class="text-xs font-semibold mb-2.5" style="color:rgb(var(--text));">{t(key as any)}</p>
              <div class="flex flex-wrap gap-1.5">{items.map(item => <span class="tag">{item}</span>)}</div>
            </div>
          ))}
        </div>
      </section>

    </div>
  </div>
</Base>

<style>
  .timeline-entry {
    display: grid;
    gap: 0.25rem 1.5rem;
  }

  .timeline-main {
    min-width: 0;
  }

  .timeline-points {
    grid-column: 1 / -1;
    max-width: none;
  }

  @media (min-width: 640px) {
    .timeline-entry {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .tech-skill-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
  }

  @media (min-width: 640px) {
    .tech-skill-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tech-skill-group {
    position: relative;
    --skill-lit: hsl(150 70% 42%);
    --skill-lit-soft: hsl(150 70% 42% / 0.16);
    --skill-lit-border: hsl(150 52% 44% / 0.42);
  }

  .tech-skill-heading {
    margin-bottom: 0.75rem;
  }

  .tech-skill-card {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    gap: 0.65rem;
    overflow: hidden;
    padding: 0.56rem 0.68rem;
    border: 1px solid rgb(var(--border));
    border-radius: 0.58rem;
    --skill-lit: hsl(150 70% 42%);
    --skill-lit-soft: hsl(150 70% 42% / 0.16);
    --skill-lit-border: hsl(150 52% 44% / 0.42);
    background:
      linear-gradient(180deg,
        color-mix(in srgb, rgb(var(--surface)) 92%, rgb(var(--surface-2))),
        color-mix(in srgb, rgb(var(--surface)) 78%, rgb(var(--surface-2))));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04);
    transition: border-color 150ms ease, background-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }

  :global(.dark) .tech-skill-group,
  :global(.dark) .tech-skill-card {
    --skill-lit: hsl(150 74% 56%);
    --skill-lit-soft: hsl(150 74% 56% / 0.17);
    --skill-lit-border: hsl(150 64% 58% / 0.44);
  }

  .tech-skill-group-lit {
    padding: 0.85rem;
    overflow: hidden;
    border: 1px solid var(--skill-lit-border);
    border-radius: 0.9rem;
    background: transparent;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.04),
      0 0 0 1px color-mix(in srgb, var(--skill-lit) 7%, transparent);
  }

  .tech-skill-group-lit::before,
  .tech-skill-card-lit::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 3px;
    background: var(--skill-lit);
    box-shadow: 0 0 12px var(--skill-lit-soft);
  }

  .tech-skill-group-lit::after {
    content: '';
    position: absolute;
    top: 0.72rem;
    right: 0.72rem;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: var(--skill-lit);
    box-shadow: 0 0 0 3px var(--skill-lit-soft);
  }

  .tech-skill-card:hover {
    border-color: rgb(var(--border-2));
    background: rgb(var(--surface));
    transform: translateY(-1px);
  }

  .tech-skill-card-lit {
    border-color: var(--skill-lit-border);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.04),
      0 0 0 1px color-mix(in srgb, var(--skill-lit) 7%, transparent);
  }

  .tech-skill-card-lit::after {
    content: '';
    position: absolute;
    top: 0.62rem;
    right: 0.62rem;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 999px;
    background: var(--skill-lit);
    box-shadow: 0 0 0 3px var(--skill-lit-soft);
    opacity: 0.88;
  }

  .tech-skill-card-lit:hover {
    border-color: color-mix(in srgb, var(--skill-lit) 54%, rgb(var(--border-2)));
  }

  .tech-skill-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgb(var(--border));
    border-radius: 0.45rem;
    background: #fff;
    color: var(--accent);
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
  }

  .tech-skill-icon img {
    width: 1.25rem;
    height: 1.25rem;
    object-fit: contain;
  }

  .tech-skill-card-lit .tech-skill-icon {
    border-color: var(--skill-lit-border);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--skill-lit) 7%, transparent);
  }

  .tech-skill-card-lit .tech-skill-name {
    color: rgb(var(--text));
  }

  .tech-skill-name {
    display: block;
    overflow-wrap: anywhere;
    color: rgb(var(--text));
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.15;
  }

</style>
