const profile = aboutContent[lang] ?? aboutContent.en;
const intro = aboutIntro[lang] ?? aboutIntro.en;
const quote = t('about.quote');
---
<Base title={t('about.title')} description={`${t('about.title')} — ${siteName}`}>
  <div class="container-mid py-16">
    <div class="mb-10 animate-fade-up">
      <h1 class="text-4xl font-bold tracking-tight"
          style="color:rgb(var(--text));letter-spacing:-0.025em;">{t('about.title')}</h1>
    </div>

    <!-- Bio prose -->
    <div class="prose dark:prose-invert max-w-none mb-14 animate-fade-up delay-100">
      {intro.map((paragraph, index) => (
        <>
          <p>
            {paragraph.map((part) => part.href ? (
              <a href={part.href} target="_blank" rel="noopener">{part.text}</a>
            ) : part.text)}
          </p>
          {index === 1 && quote && <blockquote>{quote}</blockquote>}
        </>
      ))}
    </div>

    <div class="space-y-12 animate-fade-up delay-200">
      <!-- Education -->
      <section id="education">
        <div class="flex items-center gap-4 mb-6">
