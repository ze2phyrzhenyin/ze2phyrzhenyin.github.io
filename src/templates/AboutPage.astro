---
import Base from '@/layouts/Base.astro';
import { getSiteName } from '@/lib/config';
import { useTranslations, defaultLang, withBase } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t    = useTranslations(lang);
const siteName = getSiteName(lang);

type TimelineEntry = {
  title: string;
  meta: string;
  date: string;
  points?: string[];
};

type TechnicalSkill = {
  name: string;
  icon?: string;
  mark?: string;
  note?: string;
};

type TechnicalSkillGroup = {
  title: string;
  summary: string;
  items: TechnicalSkill[];
};

type SkillGroup = {
  key: 'about.prog' | 'about.math' | 'about.tools' | 'about.lang' | 'about.sports';
  items: string[];
};

type BioPart = {
  text: string;
  href?: string;
};

type AboutContent = {
  education: TimelineEntry[];
  techSkills: TechnicalSkillGroup[];
  experience: TimelineEntry[];
  skills: SkillGroup[];
};

const universityLinks = {
  toulouse: 'https://www.ut-capitole.fr/home',
  shnu: 'https://www.shnu.edu.cn/',
};

const aboutIntro: Record<Lang, BioPart[][]> = {
  en: [
    [
      { text: 'I am currently a Master 1 student in Computer-Assisted Business Management (MIAGE) at ' },
      { text: 'Toulouse Capitole University', href: universityLinks.toulouse },
      { text: ". I completed my bachelor's degree in Computer Science at " },
      { text: 'Shanghai Normal University', href: universityLinks.shnu },
      { text: '. My previous work leaned toward software engineering and LLM applications. I came to Europe because I want to work in an area related to theoretical computer science.' },
    ],
    [
      { text: 'Over the past year, I have been self-studying foundations related to game theory, logic, and learning theory.' },
    ],
    [
      { text: 'In earlier years, I was active in volunteer work, student organizations, academic project coordination, internet marketing, and user operations. These experiences gave me solid coordination skills and a practical sense for markets and users.' },
    ],
    [
      { text: 'I have also tried and practiced across fields such as video editing, product design, venue and event operations, event initiation, growth operations, online public-service coordination during the pandemic, and French theatre performance.' },
    ],
    [
      { text: 'Beyond the internships, projects, and papers shown on this site, I have explored and built around AI-assisted stage-lighting design, ticket and workflow management platforms, cross-platform APP / uni-app / Web applications, automated score generation, comment crawling for social-media platforms, handwritten text recognition, RAG systems, and more than twenty categories of software prototypes developed through vibe coding.' },
    ],
  ],
  zh: [
    [
      { text: '我目前是' },
      { text: '图卢兹第一大学', href: universityLinks.toulouse },
      { text: '企业管理信息应用（MIAGE）硕士一年级学生。本科毕业于' },
      { text: '上海师范大学', href: universityLinks.shnu },
      { text: '计算机科学专业。我从前的方向偏向于软件工程与大模型应用。我因为想从事理论计算机相关行业，所以来到欧洲。' },
    ],
    [
      { text: '在最近的一年时间里，我自学了博弈论、逻辑、学习理论等相关基础。' },
    ],
    [
      { text: '在从前的日子里，我曾热衷于志愿服务、学生组织、学术项目管理、互联网市场营销与用户运营，因此积累了较好的组织协调能力、项目管理能力和市场敏感度。' },
    ],
    [
      { text: '我也尝试并实践过视频剪辑、产品设计、会场与活动运营、活动发起、增长运营、线上公共事务与疫情防控协作、法语话剧演出等领域。' },
    ],
    [
      { text: '除了该网站展示的实习、项目与论文以外，我还了解并实践过 AI 辅助舞台灯光设计、工单流转管理平台、APP / uni-app / Web 三端应用、乐谱自助生成、社交媒体评论爬取、手写文字识别、RAG 系统等方向，也借助 vibe coding 完成过二十余类软件原型。' },
    ],
  ],
  fr: [
    [
      { text: "Je suis actuellement étudiant en Master 1 Méthodes informatiques appliquées à la gestion des entreprises (MIAGE) à l'" },
      { text: 'Université Toulouse Capitole', href: universityLinks.toulouse },
      { text: ". J'ai obtenu une licence en informatique à l'" },
      { text: 'Université normale de Shanghai', href: universityLinks.shnu },
      { text: ". Mes orientations précédentes étaient plutôt le génie logiciel et les applications de grands modèles de langage. Je suis venu en Europe parce que je souhaite travailler dans un domaine lié à l'informatique théorique." },
    ],
    [
      { text: "Au cours de la dernière année, j'ai étudié en autonomie les bases liées à la théorie des jeux, à la logique et à la théorie de l'apprentissage." },
    ],
    [
      { text: "Dans les années précédentes, je me suis beaucoup investi dans le bénévolat, les organisations étudiantes, la coordination de projets académiques, le marketing numérique et les opérations utilisateurs. Ces expériences m'ont donné de bonnes capacités de coordination, de gestion de projet et une sensibilité concrète aux marchés et aux usages." },
    ],
    [
      { text: "J'ai également expérimenté et pratiqué le montage vidéo, la conception de produit, la gestion de lieux et d'événements, le lancement d'activités, les opérations de croissance, la coordination en ligne de services publics pendant la pandémie, ainsi que le théâtre en français." },
    ],
    [
      { text: "Au-delà des stages, projets et articles présentés sur ce site, j'ai exploré et pratiqué la conception assistée par IA pour l'éclairage scénique, les plateformes de gestion de tickets et de flux de travail, les applications multiplateformes APP / uni-app / Web, la génération automatique de partitions, le crawling de commentaires sur les réseaux sociaux, la reconnaissance d'écriture manuscrite, les systèmes RAG, ainsi que plus de vingt catégories de prototypes logiciels développés par vibe coding." },
    ],
  ],
};

