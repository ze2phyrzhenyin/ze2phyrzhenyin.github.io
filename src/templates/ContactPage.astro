---
import Base from '@/layouts/Base.astro';
import { SITE, formatEmailForDisplay } from '@/lib/config';
import { useTranslations, defaultLang } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t    = useTranslations(lang);
const pageDescription = t('contact.desc');
const displayEmail = formatEmailForDisplay(SITE.email);
const contactLabels = {
  wechat: lang === 'zh' ? '微信' : 'WeChat',
  linkedin: lang === 'zh' ? '领英' : 'LinkedIn',
};
const contactItems = [
  { label: contactLabels.wechat, value: SITE.contact.wechat },
  { label: contactLabels.linkedin, value: 'zhaoyang-sui-6260a539b', href: SITE.contact.linkedin },
  { label: 'GitHub', value: '@ze2phyrzhenyin', href: SITE.contact.github },
  { label: 'Codeforces', value: 'ze2phyr_zhenyin', href: SITE.contact.codeforces },
  { label: 'Instagram', value: '@ze2phyr', href: SITE.contact.instagram },
].filter((item) => item.value);
---
<Base title={t('contact.title')} description={pageDescription || undefined}>
  <div class="container-mid py-16">
    <header class="mb-10 animate-fade-up">
      <h1 class="text-4xl font-bold tracking-tight mb-2"
          style="color:rgb(var(--text));letter-spacing:-0.025em;">{t('contact.title')}</h1>
      {pageDescription && <p class="text-sm max-w-sm" style="color:rgb(var(--text-2));">{pageDescription}</p>}
    </header>
    <div class="space-y-3 max-w-sm animate-fade-up delay-100">
      <div class="card-accent flex items-center gap-4">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background:var(--accent-dim);">
          <svg class="w-5 h-5" style="color:var(--accent-text);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium" style="color:rgb(var(--text));">Email</p>
          <p class="font-mono text-xs truncate" style="color:rgb(var(--muted));">{displayEmail}</p>
        </div>
      </div>
      {contactItems.map((item) => item.href ? (
        <a href={item.href} target="_blank" rel="noopener" class="card-accent flex items-center gap-4 group">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 font-mono text-sm font-semibold" style="background:rgb(var(--surface-2));color:rgb(var(--text));">
            {item.label.slice(0, 2)}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium" style="color:rgb(var(--text));">{item.label}</p>
            <p class="font-mono text-xs truncate" style="color:rgb(var(--muted));">{item.value}</p>
          </div>
          <svg class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-0.5" style="color:rgb(var(--border-2));" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ) : (
        <div class="card-accent flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 font-mono text-sm font-semibold" style="background:rgb(var(--surface-2));color:rgb(var(--text));">
            {item.label.slice(0, 2)}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium" style="color:rgb(var(--text));">{item.label}</p>
            <p class="font-mono text-xs truncate" style="color:rgb(var(--muted));">{item.value}</p>
          </div>
        </div>
      ))}
    </div>
    <p class="mt-10 text-xs max-w-sm leading-relaxed animate-fade-up delay-200" style="color:rgb(var(--muted));">
      {t('contact.note')}
    </p>
  </div>
</Base>
