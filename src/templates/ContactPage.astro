---
import Base from '@/layouts/Base.astro';
import { SITE, formatEmailForDisplay } from '@/lib/config';
import { useTranslations, defaultLang } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t    = useTranslations(lang);
const pageDescription = t('contact.desc');
const displayEmail = formatEmailForDisplay(SITE.email);
const contactLabels = {
  wechat: lang === 'zh' ? '微信' : 'WeChat',
  linkedin: lang === 'zh' ? '领英' : 'LinkedIn',
};
const directItems = [
  { label: 'Email', value: displayEmail, icon: 'mail' },
  { label: contactLabels.wechat, value: SITE.contact.wechat, icon: 'wechat' },
].filter((item) => item.value);
const socialItems = [
  { label: contactLabels.linkedin, value: 'zhaoyang-sui-6260a539b', href: SITE.contact.linkedin, icon: 'linkedin' },
  { label: 'GitHub', value: '@ze2phyrzhenyin', href: SITE.contact.github, icon: 'github' },
  { label: 'Codeforces', value: 'ze2phyr_zhenyin', href: SITE.contact.codeforces, icon: 'codeforces' },
  { label: 'Instagram', value: '@ze2phyr', href: SITE.contact.instagram, icon: 'instagram' },
].filter((item) => item.value);
---
<Base title={t('contact.title')} description={pageDescription || undefined}>
  <div class="container-wide py-16 lg:py-20">
    <div class="contact-layout">
      <header class="animate-fade-up">
        <p class="section-label mb-4">{t('nav.contact')}</p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4"
            style="color:rgb(var(--text));letter-spacing:0;">{t('contact.title')}</h1>
        {pageDescription && <p class="text-base leading-relaxed max-w-md" style="color:rgb(var(--text-2));">{pageDescription}</p>}
        <p class="mt-8 text-sm leading-relaxed max-w-md" style="color:rgb(var(--muted));">{t('contact.note')}</p>
      </header>

      <div class="space-y-8 animate-fade-up delay-100">
        <section>
          <div class="contact-section-head">
            <span>{lang === 'zh' ? '直接联系' : lang === 'fr' ? 'Contact direct' : 'Direct contact'}</span>
          </div>
          <div class="contact-grid direct-grid">
            {directItems.map((item) => (
              <div class="contact-card contact-card-static">
                <div class={`contact-icon ${item.icon}`}>
                  {item.icon === 'mail' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4 6.5h16v11H4z"/>
                      <path d="m4.5 7 7.5 6 7.5-6"/>
                    </svg>
                  )}
                  {item.icon === 'wechat' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M10.2 6.2c-4 0-7.2 2.5-7.2 5.7 0 1.8 1 3.4 2.7 4.5l-.5 2 2.4-1.2c.8.2 1.7.4 2.6.4 4 0 7.2-2.5 7.2-5.7s-3.2-5.7-7.2-5.7Z"/>
                      <path d="M15.8 11.4c3.1.2 5.2 2.1 5.2 4.5 0 1.4-.8 2.7-2 3.5l.4 1.6-1.9-.9c-.6.2-1.3.3-2 .3-2.6 0-4.8-1.3-5.5-3.1"/>
                      <circle cx="7.8" cy="11.3" r=".6"/>
                      <circle cx="12.3" cy="11.3" r=".6"/>
                    </svg>
                  )}
                </div>
                <div class="min-w-0">
                  <p class="contact-label">{item.label}</p>
                  <p class="contact-value">{item.value}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section>
          <div class="contact-section-head">
            <span>{lang === 'zh' ? '社交与代码平台' : lang === 'fr' ? 'Profils' : 'Profiles'}</span>
          </div>
          <div class="contact-grid">
            {socialItems.map((item) => (
              <a href={item.href} target="_blank" rel="noopener" class="contact-card contact-link group">
                <div class={`contact-icon ${item.icon}`}>
                  {item.icon === 'linkedin' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6.9 8.9H3.7v10.2h3.2V8.9ZM5.3 4a1.9 1.9 0 1 0 0 3.8A1.9 1.9 0 0 0 5.3 4Zm13 9.2c0-3.1-1.7-4.6-4-4.6-1.8 0-2.6 1-3.1 1.7V8.9H8.1v10.2h3.2v-5.7c0-1.5.3-2.9 2.1-2.9 1.7 0 1.7 1.6 1.7 3v5.6h3.2v-5.9Z"/>
                    </svg>
                  )}
                  {item.icon === 'github' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2.5A9.7 9.7 0 0 0 8.9 21.4c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.5-1.1-4.5-4.8 0-1 .4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.6 0 3.7-2.3 4.5-4.5 4.8.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A9.7 9.7 0 0 0 12 2.5Z"/>
                    </svg>
                  )}
                  {item.icon === 'codeforces' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="4" y="9" width="4" height="10" rx="1"/>
                      <rect x="10" y="5" width="4" height="14" rx="1"/>
                      <rect x="16" y="11" width="4" height="8" rx="1"/>
                    </svg>
                  )}
                  {item.icon === 'instagram' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="4" y="4" width="16" height="16" rx="5"/>
                      <circle cx="12" cy="12" r="3.7"/>
                      <circle cx="16.8" cy="7.2" r=".8"/>
                    </svg>
                  )}
                </div>
                <div class="min-w-0 flex-1">
                  <p class="contact-label">{item.label}</p>
                  <p class="contact-value">{item.value}</p>
                </div>
                <svg class="external-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8"/>
                </svg>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  .contact-layout {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .contact-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.35fr);
      align-items: start;
    }
  }

  .contact-section-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.875rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--muted));
  }

  .contact-section-head::after {
    content: "";
    height: 1px;
    flex: 1;
    background: rgb(var(--border));
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .direct-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contact-card {
    position: relative;
    min-height: 6.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid rgb(var(--border));
    background: rgb(var(--surface) / 0.72);
    color: inherit;
    overflow: hidden;
  }

  .contact-link {
    text-decoration: none;
    transition: transform 0.16s ease, border-color 0.16s ease, background 0.16s ease;
  }

  .contact-link:hover {
    transform: translateY(-2px);
    border-color: rgb(var(--border-2));
    background: rgb(var(--surface-2) / 0.86);
  }

  .contact-card-static {
    background: linear-gradient(135deg, rgb(var(--surface-2) / 0.9), rgb(var(--surface) / 0.7));
  }

  .contact-icon {
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 2.75rem;
    display: grid;
    place-items: center;
    border-radius: 0.5rem;
    color: rgb(var(--text));
    background: rgb(var(--surface-2));
    border: 1px solid rgb(var(--border));
  }

  .contact-icon svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
  }

  .contact-icon.linkedin svg,
  .contact-icon.github svg {
    fill: currentColor;
    stroke: none;
  }

  .contact-icon.codeforces svg rect:first-child { fill: #f44336; }
  .contact-icon.codeforces svg rect:nth-child(2) { fill: #2196f3; }
  .contact-icon.codeforces svg rect:nth-child(3) { fill: #ffc107; }

  .contact-icon.mail {
    color: var(--accent-text);
    background: var(--accent-dim);
    border-color: transparent;
  }

  .contact-icon.wechat { color: #2bb741; }
  .contact-icon.linkedin { color: #0a66c2; }
  .contact-icon.github { color: rgb(var(--text)); }
  .contact-icon.instagram { color: #e4405f; }

  .contact-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: rgb(var(--text));
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .contact-value {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    line-height: 1.4;
    color: rgb(var(--muted));
    overflow-wrap: anywhere;
  }

  .external-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 1rem;
    color: rgb(var(--border-2));
    transition: transform 0.16s ease, color 0.16s ease;
  }

  .contact-link:hover .external-icon {
    transform: translate(2px, -2px);
    color: var(--accent-text);
  }
</style>
