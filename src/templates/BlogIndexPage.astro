---
import Base from '@/layouts/Base.astro';
import BlogCard from '@/components/BlogCard.astro';
import { getAllPosts } from '@/lib/utils';
import { useTranslations, defaultLang } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t    = useTranslations(lang);

const posts = await getAllPosts();
const pageDescription = t('blog.desc');
const byYear = posts.reduce((acc, post) => {
  const year = post.data.date.getFullYear();
  (acc[year] ??= []).push(post);
  return acc;
}, {} as Record<number, typeof posts>);
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---
<Base title={t('blog.title')} description={pageDescription || undefined}>
  <div class="container-mid py-16">
    <header class="mb-10 animate-fade-up">
      <h1 class="text-4xl font-bold tracking-tight mb-2"
          style="color:rgb(var(--text));letter-spacing:-0.025em;">{t('blog.title')}</h1>
      {pageDescription && <p class="text-sm" style="color:rgb(var(--text-2));">{pageDescription}</p>}
    </header>

    {posts.length === 0 ? (
      <div class="text-center py-20">
        <p class="font-mono text-sm" style="color:rgb(var(--muted));">{t('blog.empty')}</p>
      </div>
    ) : (
      <div class="space-y-14 animate-fade-up delay-100">
        {years.map(year => (
          <section>
            <div class="flex items-center gap-4 mb-7">
              <span class="font-mono text-2xl font-bold tabular" style="color:rgb(var(--text));">{year}</span>
              <div class="flex-1 h-px" style="background:rgb(var(--border));"></div>
            </div>
            <div class="space-y-6">
              {byYear[year].map(post => <BlogCard post={post} />)}
            </div>
          </section>
        ))}
      </div>
    )}
  </div>
</Base>
