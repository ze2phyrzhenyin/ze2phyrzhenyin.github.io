---
import Base from '@/layouts/Base.astro';
import { SITE, getSiteName } from '@/lib/config';
import { useTranslations, defaultLang, withBase } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t    = useTranslations(lang);
const siteName = getSiteName(lang);
const avatarSrc = withBase(SITE.avatar);
const brandMarkSrc = withBase('/brand-mark.svg');

type LinkedText = {
  text: string;
  href?: string;
};

const homeLinks = {
  toulouse: 'https://www.ut-capitole.fr/home',
  miage: 'https://www.ut-capitole.fr/accueil/formations/formations-parentes/master-mention-miage',
};

const audiences: {
  num: string;
  q: Parameters<typeof t>[0];
  desc: Parameters<typeof t>[0];
}[] = [
  { num: '01', q: 'home.aud.1.q', desc: 'home.aud.1.desc' },
  { num: '02', q: 'home.aud.2.q', desc: 'home.aud.2.desc' },
  { num: '03', q: 'home.aud.3.q', desc: 'home.aud.3.desc' },
  { num: '04', q: 'home.aud.4.q', desc: 'home.aud.4.desc' },
  { num: '05', q: 'home.aud.5.q', desc: 'home.aud.5.desc' },
];

const homeStatusParts: Record<Lang, LinkedText[]> = {
  en: [
    { text: 'Master 1 in Computer-Assisted Business Management (' },
    { text: 'MIAGE', href: homeLinks.miage },
    { text: ') · ' },
    { text: 'Toulouse Capitole University', href: homeLinks.toulouse },
  ],
  zh: [
    { text: '图卢兹第一大学 · 企业管理信息应用（' },
    { text: 'MIAGE', href: homeLinks.miage },
    { text: '）硕士一年级' },
  ],
  fr: [
    { text: 'Master 1 Méthodes informatiques appliquées à la gestion des entreprises (' },
    { text: 'MIAGE', href: homeLinks.miage },
    { text: ') · ' },
    { text: 'Université Toulouse Capitole', href: homeLinks.toulouse },
  ],
};

const homeIntro: Record<Lang, LinkedText[][]> = {
  en: [
    [
      { text: 'I am currently a Master 1 student in Computer-Assisted Business Management (' },
      { text: 'MIAGE', href: homeLinks.miage },
      { text: ') at ' },
      { text: 'Toulouse Capitole University', href: homeLinks.toulouse },
      { text: '. I came to Europe because I want to work in an area related to theoretical computer science.' },
    ],
    [
      { text: 'Over the past year, I have been self-studying foundations related to game theory, logic, and learning theory.' },
    ],
    [
      { text: 'I am still looking for the direction that fits me best; over the past month, I have found myself especially interested in proof-related topics.' },
    ],
  ],
  zh: [
    [
      { text: '我目前是' },
      { text: '图卢兹第一大学', href: homeLinks.toulouse },
      { text: '企业管理信息应用（' },
      { text: 'MIAGE', href: homeLinks.miage },
      { text: '）硕士一年级学生。我来到欧洲，是因为我希望未来从事理论计算机科学相关领域的工作。' },
    ],
    [
      { text: '在过去一年里，我自学了博弈论、逻辑和学习理论相关基础。' },
    ],
    [
      { text: '我仍在寻找最适合自己的方向；过去一个月里，我发现自己尤其对证明相关主题感兴趣。' },
    ],
  ],
  fr: [
    [
      { text: 'Je suis actuellement étudiant en Master 1 Méthodes informatiques appliquées à la gestion des entreprises (' },
      { text: 'MIAGE', href: homeLinks.miage },
      { text: ") à l'" },
      { text: 'Université Toulouse Capitole', href: homeLinks.toulouse },
      { text: ". Je suis venu en Europe parce que je souhaite travailler dans un domaine lié à l'informatique théorique." },
    ],
    [
      { text: "Au cours de l'année écoulée, j'ai étudié en autonomie des bases liées à la théorie des jeux, à la logique et à la théorie de l'apprentissage." },
    ],
    [
      { text: 'Je cherche encore la direction qui me correspond le mieux ; au cours du dernier mois, je me suis découvert un intérêt particulier pour les sujets liés aux preuves.' },
    ],
  ],
};

const statusParts = homeStatusParts[lang] ?? homeStatusParts.en;
const intro = homeIntro[lang] ?? homeIntro.en;
---
<Base>
  <!-- ── Hero ── -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-60 dark:opacity-30 pointer-events-none" />
    <div class="absolute inset-0 pointer-events-none"
         style="background:radial-gradient(ellipse 80% 60% at 50% 0%,transparent 40%,rgb(var(--bg)) 100%);"/>
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[400px] rounded-full pointer-events-none opacity-30 dark:opacity-20"
         style="background:radial-gradient(ellipse,hsl(var(--accent-h) var(--accent-s) var(--accent-l)/.25) 0%,transparent 70%);"/>
    <div class="container-narrow relative pt-24 pb-20">
      <div class="animate-fade-up inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium mb-6"
           style="background:rgb(var(--surface));border:1px solid rgb(var(--border));color:rgb(var(--text-2));">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse-slow"></span>
        <span>
          {statusParts.map((part) => part.href ? (
            <a href={part.href} target="_blank" rel="noopener" class="home-inline-link home-status-link">{part.text}</a>
          ) : part.text)}
        </span>
      </div>
      <div class="flex flex-col sm:flex-row items-start gap-7 animate-fade-up delay-100">
        <div class="shrink-0 relative">
          <div class="w-20 h-20 rounded-2xl overflow-hidden ring-2 ring-offset-2"
               style="ring-color:rgb(var(--border-2));ring-offset-color:rgb(var(--bg));">
            <div class="w-full h-full bg-gradient-to-br from-primary-600 to-primary-800 flex items-center justify-center">
              <img src={avatarSrc} alt={siteName} class="w-full h-full object-cover"
                   onerror={`this.parentElement.innerHTML='<span style="display:block;width:2.5rem;height:2.5rem;background:white;-webkit-mask:url(${brandMarkSrc}) center / contain no-repeat;mask:url(${brandMarkSrc}) center / contain no-repeat;"></span>'`}/>
            </div>
          </div>
        </div>
        <div>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight mb-4"
              style="color:rgb(var(--text));">{siteName}</h1>
          <div class="max-w-xl mb-6 space-y-3 text-sm leading-relaxed" style="color:rgb(var(--text-2));">
            {intro.map((paragraph) => (
              <p>
                {paragraph.map((part) => part.href ? (
                  <a href={part.href} target="_blank" rel="noopener" class="home-inline-link">{part.text}</a>
                ) : part.text)}
              </p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Audience section ── -->
  <section class="container-narrow pb-28 animate-fade-up delay-200">
    <!-- Section header -->
    <div class="flex items-center gap-3 mb-1">
      <span class="font-mono text-base select-none" style="color:var(--accent);">§</span>
      <p class="font-mono text-xs tracking-widest uppercase" style="color:rgb(var(--muted));">{t('home.for')}</p>
      <div class="flex-1 h-px" style="background:rgb(var(--border));"></div>
    </div>

    <!-- Accordion list -->
    <div class="aud-list" role="list">
      {audiences.map(({ num, q, desc }) => (
        <details class="aud-item" role="listitem">
          <summary class="aud-summary" tabindex="0">
            <span class="aud-num">{num}</span>
            <span class="aud-question">{t(q)}</span>
            <span class="aud-icon" aria-hidden="true">
              <svg class="icon-plus w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/>
              </svg>
              <svg class="icon-minus w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/>
              </svg>
            </span>
          </summary>
          <div class="aud-body">
            <p class="aud-desc">{t(desc)}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .home-inline-link {
    color: rgb(var(--text));
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgb(var(--border-2));
    text-underline-offset: 0.18em;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .home-inline-link:hover {
    color: var(--accent-text);
    text-decoration-color: var(--accent-text);
  }

  .home-status-link {
    color: inherit;
    font-weight: 600;
  }

  /* ── List ── */
  .aud-list {
    border-top: 1px solid rgb(var(--border));
  }

  /* ── Item ── */
  .aud-item {
    border-bottom: 1px solid rgb(var(--border));
    transition: background 0.15s;
  }
  .aud-item[open] {
    background: rgb(var(--surface));
    border-radius: 0;
  }

  /* ── Summary row ── */
  .aud-summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0.25rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: opacity 0.15s;
  }
  .aud-summary::-webkit-details-marker { display: none; }
  .aud-summary:hover { opacity: 0.85; }

  /* ── Number ── */
  .aud-num {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgb(var(--muted));
    width: 2rem;
    shrink: 0;
    transition: color 0.15s;
  }
  .aud-item[open] .aud-num,
  .aud-item:hover .aud-num {
    color: var(--accent-text);
  }

  /* ── Question label ── */
  .aud-question {
    flex: 1;
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgb(var(--text));
    line-height: 1.4;
  }

  /* ── +/- icon ── */
  .aud-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    color: rgb(var(--muted));
    transition: color 0.15s, transform 0.2s;
  }
  .aud-item:hover .aud-icon { color: rgb(var(--text-2)); }
  .icon-minus { display: none; }
  .aud-item[open] .icon-plus  { display: none; }
  .aud-item[open] .icon-minus { display: block; }
  .aud-item[open] .aud-icon   { color: var(--accent-text); }

  /* ── Body (expanded content) ── */
  .aud-body {
    padding: 0 0.25rem 1.5rem 3rem;
    animation: aud-in 0.18s ease-out;
  }
  @keyframes aud-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Description text ── */
  .aud-desc {
    font-size: 0.875rem;
    line-height: 1.75;
    color: rgb(var(--text-2));
    max-width: 52ch;
    margin-bottom: 1rem;
  }

  /* ── CTA link ── */
  .aud-cta {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
  }
  .aud-cta:hover {
    border-bottom-color: var(--accent-text);
  }
</style>
