---
import Base from '@/layouts/Base.astro';
import { SITE } from '@/lib/config';
import { useTranslations, defaultLang, withBase } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t    = useTranslations(lang);
const homeDisplayName = 'Zhaoyang SUI 隋朝阳';
const homePageTitle = homeDisplayName;
const avatarSrc = withBase(SITE.avatar);
const brandMarkSrc = withBase('/brand-mark.svg');

type LinkedText = {
  text: string;
  href?: string;
};

type AudienceCopy = {
  q: string;
  paragraphs: string[];
  list?: string[];
};

const homeLinks = {
  toulouse: 'https://www.ut-capitole.fr/home',
  miage: 'https://www.ut-capitole.fr/accueil/formations/offre-de-formation/nos-diplomes/masters/master-mention-miage-1ere-annee-formation-initiale',
};

const homeStatusParts: Record<Lang, LinkedText[]> = {
  en: [
    { text: "First-year Master's in Computer-Assisted Business Management (" },
    { text: 'MIAGE', href: homeLinks.miage },
    { text: ') · ' },
    { text: 'Toulouse Capitole University', href: homeLinks.toulouse },
  ],
  zh: [
    { text: '图卢兹第一大学 · 企业管理信息应用（' },
    { text: 'MIAGE', href: homeLinks.miage },
    { text: '）硕士一年级' },
  ],
  fr: [
    { text: 'Master 1 Méthodes informatiques appliquées à la gestion des entreprises (' },
    { text: 'MIAGE', href: homeLinks.miage },
    { text: ') · ' },
    { text: 'Université Toulouse Capitole', href: homeLinks.toulouse },
  ],
};

const homeIntro: Record<Lang, LinkedText[][]> = {
  en: [
    [
      { text: "I am a first-year master's student in Computer-Assisted Business Management (" },
      { text: 'MIAGE', href: homeLinks.miage },
      { text: ') at ' },
      { text: 'Toulouse Capitole University', href: homeLinks.toulouse },
      { text: '. The direction I have set for myself is theoretical computer science, and over the past year I have self-studied foundations related to game theory, logic, and learning theory. Over the past month, I have found myself especially interested in proof-related directions.' },
    ],
    [
      { text: 'I am eager to exchange ideas with peers on any topic related to computer science.' },
    ],
  ],
  zh: [
    [
      { text: '我是' },
      { text: '图卢兹第一大学', href: homeLinks.toulouse },
      { text: '企业管理信息应用（' },
      { text: 'MIAGE', href: homeLinks.miage },
      { text: '）硕士一年级学生。目前为自己设定的方向是理论计算机科学，并在最近一年里自学了博弈论、逻辑、学习理论等相关基础。最近一个月，我发现自己对证明相关方向的兴趣尤其浓厚。' },
    ],
    [
      { text: '渴望与同行交流所有与计算机科学相关的话题！' },
    ],
  ],
  fr: [
    [
      { text: 'Je suis étudiant en Master 1 Méthodes informatiques appliquées à la gestion des entreprises (' },
      { text: 'MIAGE', href: homeLinks.miage },
      { text: ") à l'" },
      { text: 'Université Toulouse Capitole', href: homeLinks.toulouse },
      { text: ". La direction que je me suis fixée est l'informatique théorique, et au cours de l'année écoulée j'ai étudié en autonomie des bases liées à la théorie des jeux, à la logique et à la théorie de l'apprentissage. Au cours du dernier mois, je me suis découvert un intérêt particulier pour les directions liées aux preuves." },
    ],
    [
      { text: "Je souhaite échanger avec mes pairs sur tous les sujets liés à l'informatique." },
    ],
  ],
};

const audienceContent: Record<Lang, AudienceCopy[]> = {
  en: [
    {
      q: 'If you are a professor or supervisor who wants to know more about me',
      paragraphs: [
        'I have very strong abilities in information gathering, organizing materials, and self-directed learning. I have an engineering background that was previously more application-oriented, and in recent years I have also strengthened my theoretical foundations. I am very willing to engage with research in any TCS-related area, and I would especially appreciate a small task or test from you to evaluate both my engineering and theoretical foundations.',
      ],
    },
    {
      q: 'If you are a researcher interested in collaboration',
      paragraphs: [
        'I have a strong interest in any project with positive social value, and I am good at project management and adapting to changing situations. I can contribute experience in building projects across multiple technology stacks and using a variety of AI models. If you are looking for collaborators for either of the following types of projects, feel free to contact me:',
      ],
      list: [
        'projects related to TCS;',
        'projects that combine digitalization or AI with concrete work in other fields and can significantly improve current workflows.',
      ],
    },
    {
      q: 'If you would like to talk with me',
      paragraphs: ['I welcome any topic.'],
    },
    {
      q: 'If you are looking for my help',
      paragraphs: ['I am willing to offer whatever help I can, to anyone who needs it.'],
    },
  ],
  zh: [
    {
      q: '若您是希望了解我的老师或导师',
      paragraphs: [
        '我有着极强的信息搜集、整理资料与自学能力。我有从前偏向于应用的工程背景，也在近年来提升了自己的理论基础。我很愿意接触任何与 TCS 相关领域的研究，并非常期待您能给我一个小任务或测试，来检验我的工程与理论基础。',
      ],
    },
    {
      q: '若您是有意与我合作的研究者',
      paragraphs: [
        '我对任何对社会有积极意义的项目有着浓厚的兴趣，也擅长管理项目与随机应变。我可以提供多种技术栈的项目搭建经验，以及多种 AI 模型的调用经验。如果您在寻找以下两类项目的合作者，欢迎与我联系：',
      ],
      list: [
        '与 TCS 相关的项目；',
        '将数字化 / AI 与其他领域的具体业务结合，并能够显著提升当前工作效率的项目。',
      ],
    },
    {
      q: '若您是希望与我交流的人',
      paragraphs: ['我欢迎任何话题！'],
    },
    {
      q: '若您是希望寻求我帮助的人',
      paragraphs: ['我可以为任何人提供任何我能提供的帮助。'],
    },
  ],
  fr: [
    {
      q: 'Si vous êtes enseignant·e ou directeur·rice et souhaitez mieux me connaître',
      paragraphs: [
        "J'ai de très bonnes capacités de recherche d'information, d'organisation de ressources et d'apprentissage autonome. Mon parcours d'ingénierie était auparavant plutôt orienté vers les applications, et j'ai aussi renforcé mes bases théoriques ces dernières années. Je suis très ouvert à tout sujet de recherche lié à la TCS, et j'aimerais beaucoup recevoir de votre part une petite tâche ou un test permettant d'évaluer à la fois mes bases techniques et théoriques.",
      ],
    },
    {
      q: 'Si vous êtes chercheur·se et souhaitez collaborer',
      paragraphs: [
        "Je m'intéresse vivement à tout projet ayant une valeur sociale positive, et je sais gérer des projets tout en m'adaptant rapidement aux situations imprévues. Je peux apporter une expérience de construction de projets avec plusieurs piles techniques, ainsi que d'utilisation de différents modèles d'IA. Si vous cherchez un collaborateur pour l'un des deux types de projets suivants, n'hésitez pas à me contacter :",
      ],
      list: [
        'des projets liés à la TCS ;',
        "des projets qui combinent numérisation ou IA avec un métier concret d'un autre domaine, et qui peuvent améliorer fortement les méthodes de travail actuelles.",
      ],
    },
    {
      q: 'Si vous souhaitez échanger avec moi',
      paragraphs: ["Tous les sujets sont les bienvenus."],
    },
    {
      q: "Si vous cherchez de l'aide",
      paragraphs: ["Je suis prêt à offrir toute l'aide que je peux apporter, à toute personne qui en a besoin."],
    },
  ],
};

const statusParts = homeStatusParts[lang] ?? homeStatusParts.en;
const intro = homeIntro[lang] ?? homeIntro.en;
const audiences = (audienceContent[lang] ?? audienceContent.en).map((item, index) => ({
  ...item,
  num: String(index + 1).padStart(2, '0'),
}));
---
<Base pageTitle={homePageTitle}>
  <!-- ── Hero ── -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-60 dark:opacity-30 pointer-events-none" />
    <div class="absolute inset-0 pointer-events-none"
         style="background:radial-gradient(ellipse 80% 60% at 50% 0%,transparent 40%,rgb(var(--bg)) 100%);"/>
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[400px] rounded-full pointer-events-none opacity-30 dark:opacity-20"
         style="background:radial-gradient(ellipse,hsl(var(--accent-h) var(--accent-s) var(--accent-l)/.25) 0%,transparent 70%);"/>
    <div class="container-narrow relative pt-24 pb-20">
      <div class="animate-fade-up inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium mb-6"
           style="background:rgb(var(--surface));border:1px solid rgb(var(--border));color:rgb(var(--text-2));">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse-slow"></span>
        <span>
          {statusParts.map((part) => part.href ? (
            <a href={part.href} target="_blank" rel="noopener" class="home-inline-link home-status-link">{part.text}</a>
          ) : part.text)}
        </span>
      </div>
      <div class="flex flex-col sm:flex-row items-start gap-7 animate-fade-up delay-100">
        <div class="shrink-0 relative">
          <div class="w-20 h-20 rounded-2xl overflow-hidden ring-2 ring-offset-2"
               style="ring-color:rgb(var(--border-2));ring-offset-color:rgb(var(--bg));">
            <div class="w-full h-full bg-gradient-to-br from-primary-600 to-primary-800 flex items-center justify-center">
              <img src={avatarSrc} alt={homeDisplayName} class="w-full h-full object-cover"
                   onerror={`this.parentElement.innerHTML='<span style="display:block;width:2.5rem;height:2.5rem;background:white;-webkit-mask:url(${brandMarkSrc}) center / contain no-repeat;mask:url(${brandMarkSrc}) center / contain no-repeat;"></span>'`}/>
            </div>
          </div>
        </div>
        <div>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight mb-4"
              style="color:rgb(var(--text));">{homeDisplayName}</h1>
          <div class="max-w-xl mb-6 space-y-3 text-sm leading-relaxed" style="color:rgb(var(--text-2));">
            {intro.map((paragraph) => (
              <p>
                {paragraph.map((part) => part.href ? (
                  <a href={part.href} target="_blank" rel="noopener" class="home-inline-link">{part.text}</a>
                ) : part.text)}
              </p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Audience section ── -->
  <section class="container-narrow pb-28 animate-fade-up delay-200">
    <!-- Section header -->
    <div class="flex items-center gap-3 mb-1">
      <span class="font-mono text-base select-none" style="color:var(--accent);">§</span>
      <p class="font-mono text-xs tracking-widest uppercase" style="color:rgb(var(--muted));">{t('home.for')}</p>
      <div class="flex-1 h-px" style="background:rgb(var(--border));"></div>
    </div>

    <!-- Accordion list -->
    <div class="aud-list" role="list">
      {audiences.map(({ num, q, paragraphs, list }) => (
        <details class="aud-item" role="listitem">
          <summary class="aud-summary" tabindex="0">
            <span class="aud-num">{num}</span>
            <span class="aud-question">{q}</span>
            <span class="aud-icon" aria-hidden="true">
              <svg class="icon-plus w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/>
              </svg>
              <svg class="icon-minus w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/>
              </svg>
            </span>
          </summary>
          <div class="aud-body">
            <div class="aud-copy">
              {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {list && (
                <ol class="aud-detail-list" type="a">
                  {list.map((item) => <li>{item}</li>)}
                </ol>
              )}
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .home-inline-link {
    color: rgb(var(--text));
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgb(var(--border-2));
    text-underline-offset: 0.18em;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .home-inline-link:hover {
    color: var(--accent-text);
    text-decoration-color: var(--accent-text);
  }

  .home-status-link {
    color: inherit;
    font-weight: 600;
  }

  /* ── List ── */
  .aud-list {
    border-top: 1px solid rgb(var(--border));
  }

  /* ── Item ── */
  .aud-item {
    border-bottom: 1px solid rgb(var(--border));
    transition: background 0.15s;
  }
  .aud-item[open] {
    background: rgb(var(--surface));
    border-radius: 0;
  }

  /* ── Summary row ── */
  .aud-summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0.25rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: opacity 0.15s;
  }
  .aud-summary::-webkit-details-marker { display: none; }
  .aud-summary:hover { opacity: 0.85; }

  /* ── Number ── */
  .aud-num {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgb(var(--muted));
    width: 2rem;
    shrink: 0;
    transition: color 0.15s;
  }
  .aud-item[open] .aud-num,
  .aud-item:hover .aud-num {
    color: var(--accent-text);
  }

  /* ── Question label ── */
  .aud-question {
    flex: 1;
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgb(var(--text));
    line-height: 1.4;
  }

  /* ── +/- icon ── */
  .aud-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    color: rgb(var(--muted));
    transition: color 0.15s, transform 0.2s;
  }
  .aud-item:hover .aud-icon { color: rgb(var(--text-2)); }
  .icon-minus { display: none; }
  .aud-item[open] .icon-plus  { display: none; }
  .aud-item[open] .icon-minus { display: block; }
  .aud-item[open] .aud-icon   { color: var(--accent-text); }

  /* ── Body (expanded content) ── */
  .aud-body {
    padding: 0 0.25rem 1.5rem 3rem;
    animation: aud-in 0.18s ease-out;
  }
  @keyframes aud-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Description text ── */
  .aud-copy {
    font-size: 0.875rem;
    line-height: 1.75;
    color: rgb(var(--text-2));
    max-width: 68ch;
  }

  .aud-copy > * + * {
    margin-top: 0.55rem;
  }

  .aud-detail-list {
    list-style-type: lower-alpha;
    list-style-position: outside;
    padding-left: 1.25rem;
  }

  .aud-detail-list li + li {
    margin-top: 0.25rem;
  }

  /* ── CTA link ── */
  .aud-cta {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
  }
  .aud-cta:hover {
    border-bottom-color: var(--accent-text);
  }
</style>
