---
import Base from '@/layouts/Base.astro';
import News from '@/components/News.astro';
import { SITE } from '@/lib/config';
import { useTranslations, defaultLang, localizePath, withBase } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t    = useTranslations(lang);
const homeDisplayName = 'Zhaoyang SUI 隋朝阳';
const homePageTitle = homeDisplayName;
const avatarSrc = withBase(SITE.avatar);
const portraitSrc = SITE.homePortrait && withBase(SITE.homePortrait);
const brandMarkSrc = withBase('/brand-mark.svg');

type LinkedText = {
  text: string;
  href?: string;
};

type AudienceCopy = {
  q: string;
  paragraphs: string[];
  list?: string[];
};

const homeLinks = {
  toulouse: 'https://www.ut-capitole.fr/home',
  miage: 'https://www.ut-capitole.fr/accueil/formations/offre-de-formation/nos-diplomes/masters/master-mention-miage-1ere-annee-formation-initiale',
};

const companySiteLinks: Record<Lang, string> = {
  en: 'https://rex31.com/',
  zh: 'https://rex31.com/zh/',
  fr: 'https://rex31.com/fr/',
};

const homeIntro: Record<Lang, LinkedText[][]> = {
  en: [
    [
      { text: 'I’m a first-year master’s student in Business Informatics (' },
      { text: 'MIAGE', href: homeLinks.miage },
      { text: ') at ' },
      { text: 'Toulouse Capitole University', href: homeLinks.toulouse },
      { text: ' and an entrepreneur.' },
    ],
    [
      { text: 'We mainly help businesses ' },
      { text: 'improve their operations and marketing with digital tools and AI', href: companySiteLinks.en },
      { text: '. We also pursue academic and commercial partnerships with universities and associations.' },
    ],
    [
      { text: 'I’m exploring how to build frameworks for AI agents and how people interact with computers. I think these fields will shape how we build and use software.' },
    ],
    [
      { text: 'I’d love to ' },
      { text: 'hear from others in the field', href: localizePath('/contact', lang) },
      { text: ' about anything related to computer science.' },
    ],
  ],
  zh: [
    [
      { text: '我是' },
      { text: '图卢兹第一大学', href: homeLinks.toulouse },
      { text: '企业管理信息应用（' },
      { text: 'MIAGE', href: homeLinks.miage },
      { text: '）硕士一年级学生，同时也是一个创业者。' },
    ],
    [
      { text: '目前我们主要面向企业提供' },
      { text: '数智化业务提升与营销解决方案', href: companySiteLinks.zh },
      { text: '，同时也会与高校、协会等建立学术或商业合作。' },
    ],
    [
      { text: '除此之外我也在努力探索agent框架开发与人机交互等领域，这是我认为未来软件新范式的方向。' },
    ],
    [
      { text: '渴望' },
      { text: '与同行交流', href: localizePath('/contact', lang) },
      { text: '所有与计算机科学相关的话题！' },
    ],
  ],
  fr: [
    [
      { text: 'Je suis entrepreneur et étudiant en première année de master Méthodes informatiques appliquées à la gestion des entreprises (' },
      { text: 'MIAGE', href: homeLinks.miage },
      { text: ') à l’' },
      { text: 'Université Toulouse Capitole', href: homeLinks.toulouse },
      { text: '.' },
    ],
    [
      { text: 'Nous aidons principalement les entreprises à ' },
      { text: 'améliorer leurs opérations et leur marketing grâce au numérique et à l’IA', href: companySiteLinks.fr },
      { text: '. Nous cherchons aussi à nouer des partenariats académiques ou commerciaux avec des universités et des associations.' },
    ],
    [
      { text: 'Je m’intéresse au développement de frameworks pour les agents d’IA et aux interactions humain-machine. Je pense que ces deux domaines vont changer notre façon de concevoir et d’utiliser les logiciels.' },
    ],
    [
      { text: 'J’aimerais ' },
      { text: 'échanger avec d’autres informaticiens et informaticiennes', href: localizePath('/contact', lang) },
      { text: ' sur tout ce qui touche à l’informatique.' },
    ],
  ],
};

const audienceContent: Record<Lang, AudienceCopy[]> = {
  en: [
    {
      q: 'If you are a professor or prospective academic supervisor',
      paragraphs: [
        'I have developed strong skills in gathering, synthesizing, and structuring information, as well as in self-directed learning. I am keen to get involved in research in theoretical computer science and related areas. I would especially appreciate a small research-oriented task, reading assignment, or coding exercise that could help you assess both my engineering background and my theoretical preparation.',
      ],
    },
    {
      q: 'If you are a researcher interested in collaboration',
      paragraphs: [
        'I am interested in socially meaningful projects and enjoy working on problems that connect technology with real-world needs. I am comfortable with project coordination, adapting to changing situations, and building projects across different technology stacks, including projects that involve AI tools and models.',
        'Please feel free to contact me if you are looking for collaborators for either of the following types of projects:',
      ],
      list: [
        'projects related to theoretical computer science.',
        'projects that combine digitisation or AI with domain-specific work in other fields and can meaningfully improve existing workflows.',
      ],
    },
    {
      q: 'If you would like to talk with me',
      paragraphs: ['I am open to conversations on a wide range of topics.'],
    },
    {
      q: 'If you are looking for my help',
      paragraphs: ['I am happy to help where I can.'],
    },
  ],
  zh: [
    {
      q: '若您是希望了解我的老师或导师',
      paragraphs: [
        '我有着极强的信息搜集、整理资料与自学能力。我很愿意接触任何与 TCS 相关领域的研究，并非常期待您能给我一个小任务或测试，来检验我的工程与理论基础。',
      ],
    },
    {
      q: '若您是有意与我合作的研究者',
      paragraphs: [
        '我对任何对社会有积极意义的项目有着浓厚的兴趣，也擅长管理项目与随机应变。我可以提供多种技术栈的项目搭建经验，以及多种 AI 模型的调用经验。如果您在寻找以下两类项目的合作者，欢迎与我联系：',
      ],
      list: [
        '与 TCS 相关的项目；',
        '将数字化 / AI 与其他领域的具体业务结合，并能够显著提升当前工作效率的项目。',
      ],
    },
    {
      q: '若您是希望与我交流的人',
      paragraphs: ['我欢迎任何话题！'],
    },
    {
      q: '若您是希望寻求我帮助的人',
      paragraphs: ['我可以为任何人提供任何我能提供的帮助。'],
    },
  ],
  fr: [
    {
      q: 'Si vous êtes professeur, enseignant-chercheur ou encadrant académique potentiel',
      paragraphs: [
        'J’ai développé de solides compétences en recherche, synthèse et structuration de l’information, ainsi qu’en apprentissage autonome. Je souhaite m’impliquer dans des recherches en informatique théorique ou dans des domaines proches. J’apprécierais particulièrement un petit exercice de lecture, de programmation ou de recherche qui vous permettrait d’évaluer à la fois mon profil d’ingénierie et ma préparation théorique.',
      ],
    },
    {
      q: 'Si vous êtes chercheur ou chercheuse et souhaitez collaborer',
      paragraphs: [
        'Je m’intéresse aux projets porteurs de sens, en particulier lorsqu’ils relient la technologie à des besoins concrets. Je suis à l’aise avec la coordination de projets, l’adaptation à des situations changeantes et le développement de projets dans différents environnements techniques, y compris ceux qui mobilisent des outils et modèles d’IA.',
        'N’hésitez pas à me contacter si vous recherchez des collaborateurs pour l’un des types de projets suivants :',
      ],
      list: [
        'des projets liés à l’informatique théorique.',
        'des projets qui associent le numérique ou l’IA à des problématiques de terrain dans d’autres domaines, afin d’améliorer de manière significative les méthodes de travail existantes.',
      ],
    },
    {
      q: 'Si vous souhaitez échanger avec moi',
      paragraphs: ['Je suis ouvert à des échanges sur des sujets très variés.'],
    },
    {
      q: 'Si vous pensez que je peux vous être utile',
      paragraphs: ['Je serai heureux d’aider dans la mesure de mes moyens.'],
    },
  ],
};

const statusText = t('home.status');
const intro = homeIntro[lang] ?? homeIntro.en;
const audiences = (audienceContent[lang] ?? audienceContent.en).map((item, index) => ({
  ...item,
  num: String(index + 1).padStart(2, '0'),
}));
---
<Base pageTitle={homePageTitle}>
  <!-- ── Hero ── -->
  <section class="relative overflow-hidden" aria-labelledby="profile-name">
    {!portraitSrc && <div class="absolute inset-0 dot-grid opacity-60 dark:opacity-30 pointer-events-none" />}
    <div class:list={['profile', portraitSrc ? 'profile-standing home-column' : 'profile-avatar container-narrow']}>
      {portraitSrc ? (
        <img class="profile-photo" src={portraitSrc} width="528" height="660" alt={homeDisplayName} fetchpriority="high" />
      ) : (
        <div class="profile-photo w-20 h-20 rounded-2xl overflow-hidden ring-2 ring-offset-2 bg-primary-700">
          <img src={avatarSrc} alt={homeDisplayName} class="w-full h-full object-cover"
               onerror={`this.src='${brandMarkSrc}';this.onerror=null`} />
        </div>
      )}
      <div class="profile-identity">
        <p class="profile-status"><span aria-hidden="true"></span>{statusText}</p>
        <h1 id="profile-name">
          {portraitSrc ? <>
            <span lang={lang === 'zh' ? 'zh' : undefined}>{lang === 'zh' ? SITE.nameZh : SITE.name}</span>{' '}
            <span class="profile-other-name" lang={lang === 'zh' ? 'en' : 'zh'}>{lang === 'zh' ? SITE.name : SITE.nameZh}</span>
          </> : homeDisplayName}
        </h1>
      </div>
      <div class="profile-copy">
        {intro.map((paragraph) => (
          <p>
            {paragraph.map((part) => part.href ? (
              <a href={part.href} target={part.href.startsWith('/') ? undefined : '_blank'} rel="noopener" class="home-inline-link">{part.text}</a>
            ) : part.text)}
          </p>
        ))}
      </div>
    </div>
  </section>

  <div class={portraitSrc ? 'home-column' : 'container-narrow'}>
    <News lang={lang} />
  </div>

  <!-- ── Audience section ── -->
  <section class:list={[portraitSrc ? 'home-column' : 'container-narrow', 'pb-28 animate-fade-up delay-200']}>
    <!-- Section header -->
    <div class="flex items-center gap-3 mb-1">
      <span class="font-mono text-base select-none" style="color:var(--accent);">§</span>
      <p class="font-mono text-xs tracking-widest uppercase" style="color:rgb(var(--muted));">{t('home.for')}</p>
      <div class="flex-1 h-px" style="background:rgb(var(--border));"></div>
    </div>

    <!-- Accordion list -->
    <div class="aud-list" role="list">
      {audiences.map(({ num, q, paragraphs, list }) => (
        <details class="aud-item" role="listitem">
          <summary class="aud-summary" tabindex="0">
            <span class="aud-num">{num}</span>
            <span class="aud-question">{q}</span>
            <span class="aud-icon" aria-hidden="true">
              <svg class="icon-plus w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/>
              </svg>
              <svg class="icon-minus w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/>
              </svg>
            </span>
          </summary>
          <div class="aud-body">
            <div class="aud-copy">
              {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {list && (
                <ol class="aud-detail-list" type="a">
                  {list.map((item) => <li>{item}</li>)}
                </ol>
              )}
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .home-column {
    width: min(100%, 61rem);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }
  .profile {
    position: relative;
    display: grid;
    grid-template-areas: "photo identity" "photo copy";
    align-items: start;
  }
  .profile-photo { grid-area: photo; }
  .profile-identity { grid-area: identity; align-self: end; min-width: 0; }
  .profile-copy { grid-area: copy; min-width: 0; color: rgb(var(--text-2)); }
  .profile-copy p + p { margin-top: .85em; }
  .profile-status {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    color: rgb(var(--text-2));
    font-size: .76rem;
    line-height: 1.5;
  }
  .profile-status > span {
    width: .42rem;
    height: .42rem;
    border-radius: 50%;
    background: #508367;
  }
  .profile-standing {
    grid-template-columns: clamp(12.25rem, 24vw, 16.75rem) minmax(0, 1fr);
    gap: 1.2rem clamp(2rem, 5.2vw, 4.5rem);
    padding-block: clamp(3rem, 5.5vw, 5.5rem);
  }
  .profile-standing .profile-photo {
    display: block;
    align-self: center;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: .625rem;
  }
  .profile-standing h1 {
    margin-top: .65rem;
    font-weight: 620;
    font-size: clamp(2.25rem, 4.1vw, 3.65rem);
    line-height: 1.07;
    letter-spacing: -.04em;
  }
  .profile-standing h1 > span { display: block; }
  .profile-standing h1 > [lang="zh"] { letter-spacing: .015em; }
  .profile-standing .profile-other-name {
    margin-top: .48em;
    color: rgb(var(--text-2));
    font-family: Lora, Georgia, serif;
    font-size: clamp(1.1rem, 1.55vw, 1.4rem);
    font-weight: 400;
    letter-spacing: .005em;
    line-height: 1.25;
  }
  .profile-standing .profile-copy {
    max-width: 64ch;
    font-size: clamp(.9375rem, 1.3vw, 1rem);
    line-height: 1.7;
  }
  .profile-avatar {
    grid-template: "status status" auto "photo identity" auto "photo copy" auto / 5rem minmax(0, 1fr);
    gap: 1rem 1.75rem;
    padding-block: 6rem 5rem;
  }
  .profile-avatar .profile-identity { display: contents; }
  .profile-avatar h1 { grid-area: identity; font-size: 2.25rem; line-height: 1.25; font-weight: 700; letter-spacing: -.025em; }
  .profile-avatar .profile-status {
    grid-area: status;
    justify-self: start;
    margin-bottom: .5rem;
    padding: .25rem .75rem;
    border: 1px solid rgb(var(--border));
    border-radius: 2rem;
    background: rgb(var(--surface));
  }
  .profile-avatar .profile-copy { font-size: .875rem; line-height: 1.625; }
  @media (max-width: 44.99rem) {
    .profile-standing {
      grid-template: "photo identity" auto "copy copy" auto / clamp(7.5rem, 37vw, 12.25rem) minmax(0, 1fr);
      gap: 1.55rem clamp(1rem, 5vw, 2rem);
      padding-block: clamp(1.75rem, 5vw, 3rem) 2.75rem;
    }
    .profile-standing .profile-identity { align-self: center; }
    .profile-standing h1 { margin-top: .55rem; font-size: clamp(1.72rem, 6.7vw, 2.65rem); }
    .profile-standing .profile-other-name { font-size: clamp(1rem, 3.6vw, 1.25rem); }
    .profile-standing .profile-copy { max-width: none; }
  }
  @media (max-width: 39.99rem) {
    .profile-avatar { grid-template: "status" auto "photo" auto "identity" auto "copy" auto / 1fr; }
    .profile-avatar h1 { font-size: 1.875rem; }
  }
  .home-inline-link {
    color: rgb(var(--text));
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgb(var(--border-2));
    text-underline-offset: 0.18em;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .home-inline-link:hover {
    color: var(--accent-text);
    text-decoration-color: var(--accent-text);
  }

  /* ── List ── */
  .aud-list {
    border-top: 1px solid rgb(var(--border));
  }

  /* ── Item ── */
  .aud-item {
    border-bottom: 1px solid rgb(var(--border));
    transition: background 0.15s;
  }
  .aud-item[open] {
    background: rgb(var(--surface));
    border-radius: 0;
  }

  /* ── Summary row ── */
  .aud-summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0.25rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: opacity 0.15s;
  }
  .aud-summary::-webkit-details-marker { display: none; }
  .aud-summary:hover { opacity: 0.85; }

  /* ── Number ── */
  .aud-num {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgb(var(--muted));
    width: 2rem;
    shrink: 0;
    transition: color 0.15s;
  }
  .aud-item[open] .aud-num,
  .aud-item:hover .aud-num {
    color: var(--accent-text);
  }

  /* ── Question label ── */
  .aud-question {
    flex: 1;
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgb(var(--text));
    line-height: 1.4;
  }

  /* ── +/- icon ── */
  .aud-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    color: rgb(var(--muted));
    transition: color 0.15s, transform 0.2s;
  }
  .aud-item:hover .aud-icon { color: rgb(var(--text-2)); }
  .icon-minus { display: none; }
  .aud-item[open] .icon-plus  { display: none; }
  .aud-item[open] .icon-minus { display: block; }
  .aud-item[open] .aud-icon   { color: var(--accent-text); }

  /* ── Body (expanded content) ── */
  .aud-body {
    padding: 0 0.25rem 1.5rem 3rem;
    animation: aud-in 0.18s ease-out;
  }
  @keyframes aud-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Description text ── */
  .aud-copy {
    font-size: 0.875rem;
    line-height: 1.75;
    color: rgb(var(--text-2));
    max-width: 68ch;
  }

  .aud-copy > * + * {
    margin-top: 0.55rem;
  }

  .aud-detail-list {
    list-style-type: lower-alpha;
    list-style-position: outside;
    padding-left: 1.25rem;
  }

  .aud-detail-list li + li {
    margin-top: 0.25rem;
  }

  /* ── CTA link ── */
  .aud-cta {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
  }
  .aud-cta:hover {
    border-bottom-color: var(--accent-text);
  }
</style>
