---
import { SITE, getSiteName, formatEmailForDisplay } from '@/lib/config';
import { useTranslations, defaultLang, withBase } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const updatedAt = new Date();
const year = updatedAt.getFullYear();
const siteName = getSiteName(lang);
const displayEmail = formatEmailForDisplay(SITE.email);
const brandMarkUrl = `url(${withBase('/brand-mark.svg')})`;
const dateLocales: Record<Lang, string> = {
  en: 'en-US',
  zh: 'zh-CN',
  fr: 'fr-FR',
};
const updatedAtLabel = new Intl.DateTimeFormat(dateLocales[lang], {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(updatedAt);
const updatedAtIso = updatedAt.toISOString();

---
<footer class="site-footer" style={`--brand-mark-url: ${brandMarkUrl};`}>
  <div class="container-wide footer-inner">
    <div class="footer-primary">
      <div class="footer-identity" aria-label={siteName}>
        <span class="footer-mark" aria-hidden="true"></span>
        <span>{siteName}</span>
      </div>
      <div class="footer-contact">
        <span class="footer-label">Email</span>
        <span class="footer-email">{displayEmail}</span>
      </div>
    </div>
    <div class="footer-secondary">
      <p class="footer-updated">
        <span class="footer-label">{t('footer.updated')}</span>
        <time datetime={updatedAtIso}>{updatedAtLabel}</time>
      </p>
      <p class="footer-meta">
        <span>© {year}</span>
        <span class="footer-separator" aria-hidden="true">·</span>
        <span>
          {t('footer.built')}
          <a href="https://astro.build" target="_blank" rel="noopener" class="footer-link">Astro</a>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgb(var(--border));
    padding: 1rem 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  .footer-primary,
  .footer-secondary {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .footer-primary {
    gap: clamp(1rem, 4vw, 2rem);
    flex-wrap: wrap;
  }

  .footer-secondary {
    justify-content: flex-end;
    gap: 0.75rem 1rem;
    flex-wrap: wrap;
    margin-left: auto;
  }

  .footer-identity,
  .footer-contact,
  .footer-updated,
  .footer-meta {
    color: rgb(var(--muted));
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .footer-identity {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .footer-mark {
    display: inline-block;
    width: 0.86rem;
    height: 0.86rem;
    background: rgb(var(--text));
    -webkit-mask: var(--brand-mark-url) center / contain no-repeat;
    mask: var(--brand-mark-url) center / contain no-repeat;
    flex: 0 0 auto;
  }

  .footer-contact {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
  }

  .footer-label {
    color: rgb(var(--text-2));
    font-weight: 600;
  }

  .footer-email {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    white-space: nowrap;
  }

  .footer-updated,
  .footer-meta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    margin: 0;
    white-space: nowrap;
  }

  .footer-link { color: rgb(var(--muted)); }
  .footer-link:hover { color: rgb(var(--text)); }

  @media (max-width: 720px) {
    .footer-inner {
      flex-direction: column;
      gap: 0.45rem;
    }

    .footer-primary,
    .footer-secondary {
      justify-content: center;
      margin-left: 0;
      text-align: center;
    }

    .footer-contact {
      max-width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }

    .footer-email {
      white-space: normal;
      text-align: center;
    }

    .footer-updated,
    .footer-meta {
      justify-content: center;
    }
  }
</style>
