---
import { formatDate } from '@/lib/utils';
import { localizePath, defaultLang, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, date } = post.data;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const href = localizePath(`/blog/${post.slug}`, lang);

const localizedTitles: Partial<Record<string, Partial<Record<Lang, string>>>> = {
  'differential-privacy-cpm-2026-intro': {
    zh: '差分隐私导论（持续更新）',
    fr: 'Introduction à la confidentialité différentielle (en cours)',
  },
};
const displayTitle = localizedTitles[post.slug]?.[lang] ?? title;
---
<article class="blog-item group pl-5">
  <div class="flex flex-wrap items-center gap-2 mb-2.5">
    <time datetime={date.toISOString()} class="font-mono text-xs tabular" style="color:rgb(var(--muted));">
      {formatDate(date, { month: 'short', day: 'numeric' })}
    </time>
  </div>

  <h2 class="blog-title font-semibold text-base leading-snug mb-1.5 transition-colors duration-150"
      style="color:rgb(var(--text));">
    <a href={href}>{displayTitle}</a>
  </h2>

  {description && (
    <p class="text-sm leading-relaxed max-w-2xl mb-3" style="color:rgb(var(--text-2));">
      {description}
    </p>
  )}

  <div class="flex flex-wrap gap-4">
    <a href={href} class="blog-link">{t('blog.read')} →</a>
  </div>
</article>

<style>
  .blog-item {
    border-left: 2px solid rgb(var(--border));
    transition: border-color .15s;
  }

  .blog-item:hover {
    border-left-color: var(--accent);
  }

  .blog-title a {
    color: inherit;
    text-decoration: none;
  }

  .blog-item:hover .blog-title {
    color: var(--accent-text);
  }

  .blog-link {
    color: var(--accent-text);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .blog-link:hover {
    color: rgb(var(--text));
  }
</style>
