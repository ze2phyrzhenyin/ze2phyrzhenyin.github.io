---
import { withBase } from '@/i18n/utils';
import { newsItems } from '@/data/news';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = {
  en: { heading: 'News', attended: 'Attended', awarded: 'Awarded', speaker: '3-minute lightning talk speaker' },
  zh: { heading: '最新动态', attended: '参加暑校', awarded: '获得', speaker: '三分钟快闪演讲者' },
  fr: { heading: 'Actualités', attended: 'Participation', awarded: 'Lauréat du', speaker: 'Intervenant · pitch de 3 minutes' },
}[lang];
const photoCopy = {
  en: { open: 'View full image', close: 'Close' },
  zh: { open: '查看大图', close: '关闭' },
  fr: { open: 'Agrandir l’image', close: 'Fermer' },
}[lang];
const locale = { en: 'en-GB', zh: 'zh-CN', fr: 'fr-FR' }[lang];
const dateFormat = new Intl.DateTimeFormat(locale, {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
});
---

<section id="news" class="mb-14 animate-fade-up delay-150" aria-labelledby="news-heading">
  <div class="flex items-center gap-4 mb-6">
    <h2 id="news-heading" class="section-title shrink-0">{copy.heading}</h2>
    <div class="flex-1 h-px" style="background:rgb(var(--border));"></div>
  </div>
  <ol class="news-list">
    {newsItems.map((item) => (
      <li class:list={['news-entry', { 'news-illustrated': item.image }]} id={`news-${item.id}`}>
        <p class="news-date">
          <time datetime={item.startDate}>{dateFormat.format(new Date(`${item.startDate}T00:00:00Z`))}</time>
          {item.endDate !== item.startDate && <>
            <span aria-hidden="true"> – </span>
            <time datetime={item.endDate}>{dateFormat.format(new Date(`${item.endDate}T00:00:00Z`))}</time>
          </>}
        </p>
        <div class="news-detail">
          <h3 class="news-title">
            {item.url ? <a href={item.url} lang={item.titleLang} target="_blank" rel="noopener noreferrer">
              {typeof item.title === 'string' ? item.title : item.title[lang]}<span class="news-arrow" aria-hidden="true"> ↗</span>
            </a> : typeof item.title === 'string' ? item.title : item.title[lang]}
          </h3>
          {item.location && <p class="news-location">{item.location[lang].country} · {item.location[lang].city}</p>}
          {item.venue && <p class="news-location">{item.venue[lang]}</p>}
          {item.audience && <p class="news-location">{item.audience[lang]}</p>}
          <p class:list={['news-summary', { 'news-award': item.award }]}>
            {item.award ? <>{copy.awarded}{'\u00A0'}<strong lang="fr">{item.award}</strong></> : item.role === 'lightning-talk-speaker' ? copy.speaker : (item.summary?.[lang] ?? copy.attended)}
          </p>
        </div>
        {item.image && (
          <a class="news-media" href={withBase(item.image.src)} data-news-photo
            aria-label={`${photoCopy.open} · ${item.image.alt[lang]}`}>
            <img src={withBase(item.image.src)} width={item.image.width} height={item.image.height}
              alt={item.image.alt[lang]} loading="lazy" decoding="async" />
          </a>
        )}
      </li>
    ))}
  </ol>
  <dialog class="news-viewer" aria-label={photoCopy.open}>
    <form method="dialog"><button autofocus>{photoCopy.close} <span aria-hidden="true">×</span></button></form>
    <img alt="" />
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.news-viewer');
  const preview = dialog?.querySelector('img');
  if (dialog && preview) {
    document.querySelectorAll<HTMLAnchorElement>('[data-news-photo]').forEach(link => {
      link.addEventListener('click', event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        preview.src = link.href;
        preview.alt = link.querySelector('img')?.alt ?? '';
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .news-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .news-entry {
    scroll-margin-block-start: 5rem;
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgb(var(--border));
  }

  .news-entry:first-child { padding-top: 0; }
  .news-entry:last-child { border-bottom: 0; padding-bottom: 0; }

  .news-date {
    margin: 0;
    color: rgb(var(--muted));
    font-size: 0.75rem;
    line-height: 1.75;
    font-variant-numeric: tabular-nums;
  }

  .news-detail { min-width: 0; }

  .news-date time { white-space: nowrap; }

  .news-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.65;
    overflow-wrap: anywhere;
    color: rgb(var(--text));
  }

  .news-title a {
    text-decoration: underline;
    text-decoration-color: rgb(var(--border-2));
    text-underline-offset: 0.2em;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .news-title a:hover,
  .news-title a:focus-visible {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }

  .news-arrow { white-space: nowrap; color: rgb(var(--muted)); }

  .news-location,
  .news-summary {
    margin: 0.35rem 0 0;
    color: rgb(var(--text-2));
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .news-location { color: rgb(var(--muted)); }

  .news-award { color: var(--accent-text); }

  @media (min-width: 640px) {
    .news-entry { grid-template-columns: 10rem minmax(0, 1fr); gap: 1.5rem; }
  }

  .news-entry.news-illustrated {
    grid-template-areas: "date" "detail" "photo";
    grid-template-columns: minmax(0, 1fr);
    gap: .45rem;
    margin-block: 1.25rem;
    padding: clamp(1rem, 3vw, 1.75rem);
    border: 1px solid rgb(var(--border));
    border-radius: 1rem;
    background: rgb(var(--surface));
  }

  .news-illustrated .news-date { grid-area: date; }
  .news-illustrated .news-detail { grid-area: detail; }
  .news-illustrated .news-title { font-size: clamp(1.15rem, 2vw, 1.45rem); line-height: 1.45; }
  .news-illustrated .news-location { text-wrap: balance; }
  .news-illustrated .news-summary { margin-top: .85rem; }

  .news-media {
    grid-area: photo;
    display: block;
    margin-top: .65rem;
    min-width: 0;
    cursor: zoom-in;
  }

  .news-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: .4rem;
  }

  .news-viewer {
    margin: auto;
    width: fit-content;
    max-width: calc(100% - 1.5rem);
    max-height: 94dvh;
    padding: .65rem;
    border: 1px solid rgb(var(--border));
    border-radius: .75rem;
    background: rgb(var(--surface));
    color: rgb(var(--text));
  }

  .news-viewer::backdrop { background: rgb(10 9 8 / .8); }
  .news-viewer form { display: flex; justify-content: flex-end; }
  .news-viewer button { padding: .5rem .65rem; min-height: 44px; cursor: pointer; }
  .news-viewer img { display: block; max-width: 100%; max-height: calc(90dvh - 4rem); object-fit: contain; }

  @media (min-width: 640px) {
    .news-entry.news-illustrated {
      grid-template: "date photo" auto "detail photo" auto / minmax(0, 1fr) minmax(0, .85fr);
      align-content: center;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
    .news-illustrated .news-date { align-self: end; }
    .news-media { align-self: center; margin-top: 0; }
  }
</style>
