---
import { formatDate } from '@/lib/utils';
import { localizePath, defaultLang, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  essay: CollectionEntry<'essays'>;
}
const { essay } = Astro.props;
const { title, description, date } = essay.data;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const href = localizePath(`/essays/${essay.slug}`, lang);

const localizedTitles: Partial<Record<string, Partial<Record<Lang, string>>>> = {
  'my-summer-schools-in-2026-overview': {
    zh: '我的 2026 年暑期学校概览（持续更新）',
    fr: 'Aperçu de mes écoles d’été en 2026 (en cours)',
  },
};
const displayTitle = localizedTitles[essay.slug]?.[lang] ?? title;
---
<article class="essay-item group pl-5">
  <div class="flex flex-wrap items-center gap-2 mb-2.5">
    <time datetime={date.toISOString()} class="font-mono text-xs tabular" style="color:rgb(var(--muted));">
      {formatDate(date, { month: 'short', day: 'numeric' })}
    </time>
  </div>

  <h2 class="essay-title font-semibold text-base leading-snug mb-1.5 transition-colors duration-150"
      style="color:rgb(var(--text));">
    <a href={href}>{displayTitle}</a>
  </h2>

  {description && (
    <p class="text-sm leading-relaxed max-w-2xl mb-3" style="color:rgb(var(--text-2));">
      {description}
    </p>
  )}

  <div class="flex flex-wrap gap-4">
    <a href={href} class="essay-link">{t('essays.read')} →</a>
  </div>
</article>

<style>
  .essay-item {
    border-left: 2px solid rgb(var(--border));
    transition: border-color .15s;
  }

  .essay-item:hover {
    border-left-color: var(--accent);
  }

  .essay-title a {
    color: inherit;
    text-decoration: none;
  }

  .essay-item:hover .essay-title {
    color: var(--accent-text);
  }

  .essay-link {
    color: var(--accent-text);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .essay-link:hover {
    color: rgb(var(--text));
  }
</style>
